						if flag then CryptHub.Options[flag] = SFuncs end
						if opts.Callback then opts.Callback(SFuncs.Value) end
					end
					btn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end end)
					UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
					UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end end)
					
					function SFuncs:UpdateName(n) lbl.Text = n end
					function SFuncs:UpdateValue(v) SFuncs.Value = v; fill.Size = UDim2.fromScale((v - (opts.Minimum or 0)) / ((opts.Maximum or 100) - (opts.Minimum or 0)), 1); valLbl.Text = tostring(v) end
