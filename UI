						Text=Cfg.Name or "Input", TextColor3=T.TextSecondary, TextSize=13,
						FontFace=FF(), TextXAlignment=Enum.TextXAlignment.Left,
						LayoutOrder=0, Parent=outer,
					})
					local box = New("TextBox", {
						BackgroundColor3=T.InputBg, BorderSizePixel=0,
						ClearTextOnFocus=false,
						PlaceholderText=Cfg.Placeholder or "Enter text...",
						PlaceholderColor3=T.TextMuted,
						Text=Cfg.Default or "",
						TextColor3=T.TextPrimary, TextSize=13,
						FontFace=FF(), TextXAlignment=Enum.TextXAlignment.Left,
						Size=UDim2.new(1,0,0,34), LayoutOrder=1, Parent=outer,
					})
					MakeCorner(box,T.Rsm)
					MakeStroke(box,T.BorderLight,0.78)
					MakePad(box,0,10,0,10)

					local filters = {
						All          = function(v) return v end,
						Numeric      = function(v) return v:gsub("[^%d%.-]","") end,
						Alphabetic   = function(v) return v:gsub("[^%a ]","") end,
						AlphaNumeric = function(v) return v:gsub("[^%a%d]","") end,
					}
					local filt = type(Cfg.AcceptedCharacters)=="function"
						and Cfg.AcceptedCharacters
						or (filters[Cfg.AcceptedCharacters] or filters.All)

					box:GetPropertyChangedSignal("Text"):Connect(function()
						local t = filt(box.Text)
						if Cfg.CharacterLimit then t=t:sub(1,Cfg.CharacterLimit) end
						if box.Text~=t then box.Text=t end
						IF.Text=box.Text
						if Cfg.onChanged then Cfg.onChanged(box.Text) end
					end)
					box.FocusLost:Connect(function()
						local t=filt(box.Text)
						if Cfg.CharacterLimit then t=t:sub(1,Cfg.CharacterLimit) end
						box.Text=t; IF.Text=t
						if Cfg.Callback then task.spawn(Cfg.Callback,t) end
					end)
					function IF:GetInput()        return box.Text end
					function IF:UpdateText(t)
						local f=filt(t); box.Text=f; IF.Text=f
						if Cfg.Callback then task.spawn(Cfg.Callback,f) end
					end
					function IF:UpdatePlaceholder(p) box.PlaceholderText=p end
					function IF:UpdateName(_)     end
					function IF:SetVisibility(s)  outer.Visible=s end
					if Flag then UILib.Options[Flag]=IF end
					return IF
				end

				function SF:Keybind(Cfg, Flag)
					local KF = { Settings=Cfg, Class="Keybind", IgnoreConfig=false }
					local binded = Cfg.Default
					local focused, isBinding = false, false
					Sep()
					local row = Row(40)
					New("TextLabel", {
						BackgroundTransparency=1, BorderSizePixel=0,
						AnchorPoint=Vector2.new(0,0.5), Position=UDim2.fromScale(0,0.5),
						AutomaticSize=Enum.AutomaticSize.Y, Size=UDim2.new(0.55,0,0,0),
						Text=Cfg.Name or "", TextColor3=T.TextSecondary, TextSize=13,
						FontFace=FF(), TextXAlignment=Enum.TextXAlignment.Left, Parent=row,
					})
					local kbox = New("TextBox", {
						AnchorPoint=Vector2.new(1,0.5),
						BackgroundColor3=T.InputBg, BorderSizePixel=0,
						CursorPosition=-1,
						Position=UDim2.fromScale(1,0.5),
						Size=UDim2.fromOffset(75,26),
						PlaceholderText="...",
						Text=binded and binded.Name or "",
						TextColor3=T.TextPrimary, TextSize=12,
						FontFace=FF(), ClipsDescendants=true, Parent=row,
					})
					MakeCorner(kbox,T.Rsm)
					MakeStroke(kbox,T.BorderLight,0.78)
					MakePad(kbox,0,5,0,5)

					kbox.Focused:Connect(function() focused=true end)
					kbox.FocusLost:Connect(function() focused=false; isBinding=false end)

					local ev
					kbox.Focused:Connect(function()
						focused=true
						if ev then ev:Disconnect() end
						ev = UserInputService.InputBegan:Connect(function(inp)
							if not focused then return end
							local bl = Cfg.Blacklist
							if bl and (table.find(bl,inp.KeyCode) or table.find(bl,inp.UserInputType)) then
								kbox:ReleaseFocus(); return
							end
							if inp.UserInputType==Enum.UserInputType.Keyboard then
								binded=inp.KeyCode; kbox.Text=inp.KeyCode.Name
							elseif inp.UserInputType==Enum.UserInputType.MouseButton1
							    or inp.UserInputType==Enum.UserInputType.MouseButton2 then
								binded=inp.UserInputType; kbox.Text=inp.UserInputType.Name
							end
							if Cfg.onBinded then task.spawn(Cfg.onBinded,binded) end
							kbox:ReleaseFocus()
							if ev then ev:Disconnect() end
						end)
					end)

					UserInputService.InputBegan:Connect(function(inp,gpe)
						if gpe or focused or isBinding then return end
						if binded and (inp.KeyCode==binded or inp.UserInputType==binded) then
							if Cfg.Callback then task.spawn(Cfg.Callback,binded) end
							if Cfg.onBindHeld then task.spawn(Cfg.onBindHeld,true,binded) end
						end
					end)
					UserInputService.InputEnded:Connect(function(inp)
						if focused then return end
						if binded and (inp.KeyCode==binded or inp.UserInputType==binded) then
							if Cfg.onBindHeld then task.spawn(Cfg.onBindHeld,false,binded) end
						end
					end)

					function KF:Bind(k)      binded=k; kbox.Text=k.Name end
					function KF:Unbind()     binded=nil; kbox.Text="" end
					function KF:GetBind()    return binded end
					function KF:UpdateName(_)end
					function KF:SetVisibility(s) row.Visible=s end
					if Flag then UILib.Options[Flag]=KF end
					return KF
				end

