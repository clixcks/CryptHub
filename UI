			function TabFunctions:InsertConfigSection(side)
				local cs = TabFunctions:Section({ Side = side or "Left", Name = "Config" })
				if isStudio then
					cs:Label({ Text = "Config unavailable (Studio)" })
					return "Unavailable"
				end
				local inputPath, selectedConfig = nil, nil
				cs:Input({
					Name = "Config Name", Placeholder = "Name",
					AcceptedCharacters = "All",
					Callback = function(v) inputPath = v end,
				})
				local cfgDrop = cs:Dropdown({
					Name = "Config", Multi = false, Required = false,
					Options = UILib:RefreshConfigList(),
					Callback = function(v) selectedConfig = v end,
				})
				cs:Button({ Name = "Create Config", Callback = function()
					if not inputPath or inputPath:gsub(" ","")=="" then
						WindowFunctions:Notify({Title="Config",Description="Name cannot be empty."}); return
					end
					local ok,err = UILib:SaveConfig(inputPath)
					if not ok then WindowFunctions:Notify({Title="Config",Description="Error: "..tostring(err)}); return end
					WindowFunctions:Notify({Title="Config",Description='Created "'..inputPath..'"'})
					cfgDrop:ClearOptions(); cfgDrop:InsertOptions(UILib:RefreshConfigList())
				end })
				cs:Button({ Name = "Load Config", Callback = function()
					local ok,err = UILib:LoadConfig(cfgDrop.Value)
					if not ok then WindowFunctions:Notify({Title="Config",Description="Error: "..tostring(err)}); return end
					WindowFunctions:Notify({Title="Config",Description='Loaded "'..tostring(cfgDrop.Value)..'"'})
				end })
				cs:Button({ Name = "Overwrite Config", Callback = function()
					local ok,err = UILib:SaveConfig(cfgDrop.Value)
					if not ok then WindowFunctions:Notify({Title="Config",Description="Error: "..tostring(err)}); return end
					WindowFunctions:Notify({Title="Config",Description='Saved "'..tostring(cfgDrop.Value)..'"'})
				end })
				cs:Button({ Name = "Refresh List", Callback = function()
					cfgDrop:ClearOptions(); cfgDrop:InsertOptions(UILib:RefreshConfigList())
				end })
				local autoLbl = cs:Label({ Text = "Autoload: None" })
				cs:Button({ Name = "Set as Autoload", Callback = function()
					local name = cfgDrop.Value
					if not name then return end
					writefile(UILib.Folder.."/settings/autoload.txt", name)
					autoLbl:UpdateName("Autoload: "..name)
					WindowFunctions:Notify({Title="Config",Description='Set autoload: "'..name..'"'})
