					function DF:SetVisibility(s)  outer.Visible=s end
					function DF:UpdateSelection(sel)
						for name in pairs(OptObjs) do OptSel(name,false) end
						Selected={}
						if type(sel)=="string" then OptSel(sel,true)
						elseif type(sel)=="number" then
							for name,d in pairs(OptObjs) do
								if d.index==sel then OptSel(name,true) end
							end
						elseif type(sel)=="table" then
							for _,name in ipairs(sel) do OptSel(name,true) end
						end
						if Cfg.Callback then
							if Cfg.Multi then
								local R={}; for _,s in ipairs(Selected) do R[s]=true end
								Cfg.Callback(R)
							else Cfg.Callback(Selected[1]) end
						end
					end
					function DF:InsertOptions(opts)
						for i,v in ipairs(opts) do AddOpt(i,v) end
					end
					function DF:ClearOptions()
						for _,o in pairs(OptObjs) do o.btn:Destroy() end
						OptObjs={}; Selected={}; UpdatePill(); CloseDropdown()
					end
					function DF:GetOptions()
						local out={}
						for name in pairs(OptObjs) do out[name]=table.find(Selected,name)~=nil end
						return out
					end
					function DF:RemoveOptions(list)
						for _,name in ipairs(list) do
							if OptObjs[name] then OptObjs[name].btn:Destroy(); OptObjs[name]=nil end
							local idx=table.find(Selected,name)
							if idx then table.remove(Selected,idx) end
						end
						UpdatePill()
					end
					function DF:IsOption(name) return OptObjs[name]~=nil end

					if Flag then UILib.Options[Flag]=DF end
					return DF
				end

