	local function SelectTab(tabBtn)
		if not tabRegistry[tabBtn] then return end

		if currentTabBtn and tabRegistry[currentTabBtn] then
			local old = tabRegistry[currentTabBtn]
			old.content.Parent = nil
			Tween(currentTabBtn, TweenInfo.new(0.15,Enum.EasingStyle.Sine),
				{ BackgroundTransparency = 1 }):Play()
			if old.nameLabel then
				Tween(old.nameLabel, TweenInfo.new(0.15,Enum.EasingStyle.Sine),
					{ TextTransparency = 0.45 }):Play()
			end
			if old.iconLabel then
				local prop = old.iconLabel:IsA("ImageLabel") and "ImageTransparency" or "TextTransparency"
				Tween(old.iconLabel, TweenInfo.new(0.15,Enum.EasingStyle.Sine),
					{ [prop] = 0.5 }):Play()
			end
		end

		currentTabBtn = tabBtn
		local info = tabRegistry[tabBtn]
		info.content.Parent = contentBody
		ctTabName.Text = info.name
		Tween(tabBtn, TweenInfo.new(0.15,Enum.EasingStyle.Sine),
			{ BackgroundTransparency = 0 }):Play()
		if info.nameLabel then
			Tween(info.nameLabel, TweenInfo.new(0.15,Enum.EasingStyle.Sine),
				{ TextTransparency = 0 }):Play()
		end
		if info.iconLabel then
			local prop = info.iconLabel:IsA("ImageLabel") and "ImageTransparency" or "TextTransparency"
			Tween(info.iconLabel, TweenInfo.new(0.15,Enum.EasingStyle.Sine),
				{ [prop] = 0 }):Play()
		end
	end

