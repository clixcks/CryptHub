	local ClassParser = {
		Toggle = {
			Save = function(f,d) return {type="Toggle",flag=f,state=d.State or false} end,
			Load = function(f,d)
				if UILib.Options[f] and d.state~=nil then UILib.Options[f]:UpdateState(d.state) end
			end,
		},
		Slider = {
			Save = function(f,d) return {type="Slider",flag=f,value=d.Value and tostring(d.Value)} end,
			Load = function(f,d)
				if UILib.Options[f] and d.value then UILib.Options[f]:UpdateValue(d.value) end
			end,
		},
		Input = {
			Save = function(f,d) return {type="Input",flag=f,text=d.Text} end,
			Load = function(f,d)
				if UILib.Options[f] and d.text and type(d.text)=="string" then
					UILib.Options[f]:UpdateText(d.text)
				end
			end,
		},
		Keybind = {
			Save = function(f,d)
				local b = d.GetBind and d:GetBind()
				return {type="Keybind",flag=f,bind=(typeof(b)=="EnumItem") and b.Name or nil}
			end,
			Load = function(f,d)
				if UILib.Options[f] and d.bind then
					UILib.Options[f]:Bind(Enum.KeyCode[d.bind])
				end
			end,
		},
		Dropdown = {
			Save = function(f,d) return {type="Dropdown",flag=f,value=d.Value} end,
			Load = function(f,d)
				if UILib.Options[f] and d.value then UILib.Options[f]:UpdateSelection(d.value) end
			end,
		},
		Colorpicker = {
			Save = function(f,d)
				local c=d.Color
				local hex=c and string.format("#%02X%02X%02X",
					math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
				return {type="Colorpicker",flag=f,color=hex,alpha=d.Alpha}
			end,
			Load = function(f,d)
				if UILib.Options[f] and d.color then
					local r=tonumber(d.color:sub(2,3),16)/255
					local g=tonumber(d.color:sub(4,5),16)/255
					local b=tonumber(d.color:sub(6,7),16)/255
					UILib.Options[f]:SetColor(Color3.new(r,g,b))
					if d.alpha then UILib.Options[f]:SetAlpha(d.alpha) end
				end
			end,
		},
	}

	local function BuildFolderTree()
		if isStudio or not (isfolder and makefolder) then return end
		for _, p in ipairs({ UILib.Folder, UILib.Folder.."/settings" }) do
			if not isfolder(p) then makefolder(p) end
		end
	end

	function UILib:LoadAutoLoadConfig()
		if isStudio or not (isfile and readfile) then return end
		if isfile(UILib.Folder.."/settings/autoload.txt") then
			local name = readfile(UILib.Folder.."/settings/autoload.txt")
			local ok,err = UILib:LoadConfig(name)
			if not ok then
				WindowFunctions:Notify({Title="Config",Description="Autoload error: "..tostring(err)})
			else
				WindowFunctions:Notify({Title="Config",Description='Autoloaded "'..name..'"'})
			end
		end
	end

	function UILib:SetFolder(f)
		UILib.Folder=f; BuildFolderTree()
	end

	function UILib:SaveConfig(path)
		if isStudio or not writefile then return false,"Unavailable" end
		if not path then return false,"No path given" end
		local data={objects={}}
		for flag,opt in pairs(UILib.Options) do
			if ClassParser[opt.Class] and not opt.IgnoreConfig then
				table.insert(data.objects, ClassParser[opt.Class].Save(flag,opt))
			end
		end
		local ok,enc=pcall(HttpService.JSONEncode,HttpService,data)
		if not ok then return false,"JSON encode error" end
		writefile(UILib.Folder.."/settings/"..path..".json", enc)
		return true
	end

	function UILib:LoadConfig(path)
		if isStudio or not (isfile and readfile) then return false,"Unavailable" end
		if not path then return false,"No path given" end
		local file=UILib.Folder.."/settings/"..path..".json"
		if not isfile(file) then return false,"File not found" end
		local ok,dec=pcall(HttpService.JSONDecode,HttpService,readfile(file))
		if not ok then return false,"JSON decode error" end
		for _,opt in ipairs(dec.objects or {}) do
			if ClassParser[opt.type] then
				task.spawn(function() ClassParser[opt.type].Load(opt.flag,opt) end)
			end
		end
		return true
	end

	function UILib:RefreshConfigList()
		if isStudio or not (isfolder and listfiles) then return {} end
		local list=(isfolder(UILib.Folder) and isfolder(UILib.Folder.."/settings"))
			and listfiles(UILib.Folder.."/settings") or {}
		local out={}
		for _,file in ipairs(list) do
			if file:sub(-5)==".json" then
				local pos=file:find(".json",1,true)
				local start=pos
				local char=file:sub(pos,pos)
				while char~="/" and char~="\\" and char~="" and pos>1 do
					pos=pos-1; char=file:sub(pos,pos)
				end
				if char=="/" or char=="\\" then
					local name=file:sub(pos+1,start-1)
					if name~="options" then table.insert(out,name) end
				end
			end
		end
		return out
	end

