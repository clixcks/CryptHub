						TextXAlignment=Enum.TextXAlignment.Left, Parent=rangeRow,
					})
					local maxLbl = New("TextLabel", {
						BackgroundTransparency=1, BorderSizePixel=0,
						AnchorPoint=Vector2.new(1,0), Position=UDim2.fromScale(1,0),
						Size=UDim2.fromOffset(60,14),
						Text=tostring(mx), TextColor3=T.TextMuted, TextSize=10,
						TextXAlignment=Enum.TextXAlignment.Right, Parent=rangeRow,
					})

					local DM = {
						Round   = function(v,p) return p and string.format("%."..p.."f",v) or tostring(math.round(v)) end,
						Degrees = function(v,p) return (p and string.format("%."..p.."f",v) or tostring(v)).."°" end,
						Percent = function(v,p)
							local pct=(v-mn)/(mx-mn)*100
							return (p and string.format("%."..p.."f",pct) or tostring(math.round(pct))).."%"
						end,
						Value       = function(v,p) return p and string.format("%."..p.."f",v) or tostring(v) end,
						Hundredths  = function(v) return string.format("%.2f",v) end,
						Tenths      = function(v) return string.format("%.1f",v) end,
					}
					local disp = DM[Cfg.DisplayMethod] or DM.Value

					local function SetVal(posX, fire)
						posX  = math.clamp(posX,0,1)
						val   = posX*(mx-mn)+mn
						SlF.Value = val
						fill.Size = UDim2.new(posX,0,1,0)
						thumb.Position = UDim2.new(posX,0,0.5,0)
						local txt = (Cfg.Prefix or "")..disp(val,Cfg.Precision)..(Cfg.Suffix or "")
						minLbl.Text = txt
						if fire and Cfg.Callback then task.spawn(Cfg.Callback,val) end
					end

					local function ValFromInput(inp)
						local rel = (inp.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
						SetVal(rel, true)
