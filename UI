					local function mkSlider(initVal)
						local sf = Create("Frame", { Size = UDim2.new(1, -20, 0, 12), BackgroundColor3 = Colors.Element, ZIndex = 11, Parent = pFrame }); Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = sf })
						local fill = Create("Frame", { Size = UDim2.fromScale(initVal, 1), BackgroundColor3 = Colors.TextPrimary, ZIndex = 11, Parent = sf }); Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
						local btn = Create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 12, Parent = sf })
						local function update(inp) local clamped = math.clamp((inp.Position.X - sf.AbsolutePosition.X) / sf.AbsoluteSize.X, 0, 1); fill.Size = UDim2.fromScale(clamped, 1); return clamped end
						return btn, update
					end
					local rBtn, rUp = mkSlider(CFuncs.Color.R); local gBtn, gUp = mkSlider(CFuncs.Color.G); local bBtn, bUp = mkSlider(CFuncs.Color.B)
					
					function CFuncs:UpdateColor(c)
						CFuncs.Color = c; colBtn.BackgroundColor3 = c; hexLbl.Text = "#" .. c:ToHex():upper()
						if flag then CryptHub.Options[flag] = CFuncs end
						if opts.Callback then opts.Callback(c) end
					end
					
					local dragNode = nil
					local function connDrag(btn, updFunc, idx)
						btn.InputBegan:Connect(function(input)
							if input.UserInputType == Enum.UserInputType.MouseButton1 then
								dragNode = idx
								local v = updFunc(input)
								if idx==1 then CFuncs:UpdateColor(Color3.new(v, CFuncs.Color.G, CFuncs.Color.B))
								elseif idx==2 then CFuncs:UpdateColor(Color3.new(CFuncs.Color.R, v, CFuncs.Color.B))
								else CFuncs:UpdateColor(Color3.new(CFuncs.Color.R, CFuncs.Color.G, v)) end
							end
						end)
					end
					connDrag(rBtn, rUp, 1); connDrag(gBtn, gUp, 2); connDrag(bBtn, bUp, 3)
					UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragNode = nil end end)
					UserInputService.InputChanged:Connect(function(input)
						if dragNode and input.UserInputType == Enum.UserInputType.MouseMovement then
							if dragNode == 1 then CFuncs:UpdateColor(Color3.new(rUp(input), CFuncs.Color.G, CFuncs.Color.B))
							elseif dragNode == 2 then CFuncs:UpdateColor(Color3.new(CFuncs.Color.R, gUp(input), CFuncs.Color.B))
							else CFuncs:UpdateColor(Color3.new(CFuncs.Color.R, CFuncs.Color.G, bUp(input))) end
						end
					end)
					colBtn.MouseButton1Click:Connect(function() pFrame.Visible = not pFrame.Visible end)
					
					function CFuncs:UpdateName(n) lbl.Text = n end
					function CFuncs:SetVisibility(v) row.Visible = v end
					if flag then CryptHub.Options[flag] = CFuncs end
					return CFuncs
				end
				
