							ValFromInput(inp)
						end
					end)

					function SlF:UpdateValue(v)
						v = tonumber(v) or val
						SetVal(math.clamp((v-mn)/(mx-mn),0,1), false)
					end
					function SlF:GetValue()       return val end
					function SlF:UpdateName(n)    sliderNameLbl.Text = n end
					function SlF:SetVisibility(s) outer.Visible = s end
					if Flag then UILib.Options[Flag] = SlF end
					return SlF
				end

				function SF:Input(Cfg, Flag)
					local IF = { Settings = Cfg, Text = Cfg.Default or "", Class = "Input", IgnoreConfig = false }
					Sep()
					local outer = New("Frame", {
						BackgroundTransparency=1, BorderSizePixel=0,
						Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
						LayoutOrder=elemOrder, Parent=elemWrap,
