					local fill = Create("Frame", { Size = UDim2.fromScale( (SFuncs.Value - (opts.Minimum or 0)) / ((opts.Maximum or 100) - (opts.Minimum or 0)), 1), BackgroundColor3 = Colors.TextPrimary, Parent = sbg })
