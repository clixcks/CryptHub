local function Tween(inst, info, props)
	return TweenService:Create(inst, info, props)
end

local function New(class, props)
	local ok, inst = pcall(Instance.new, class)
	if not ok then return nil end
	for k, v in pairs(props) do
		if k ~= "Parent" then
			pcall(function() inst[k] = v end)
		end
	end
	if props.Parent then inst.Parent = props.Parent end
	return inst
end

local function MakeCorner(p, r)
	return New("UICorner", { CornerRadius = r or T.R, Parent = p })
end
local function MakeStroke(p, col, tr, th)
	return New("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color           = col or T.Border,
		Transparency    = tr  or 0.85,
		Thickness       = th  or 1,
		Parent          = p,
	})
end
local function MakePad(p, top, right, bot, left)
	return New("UIPadding", {
		PaddingTop    = UDim.new(0, top   or 0),
		PaddingRight  = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bot   or 0),
		PaddingLeft   = UDim.new(0, left  or 0),
		Parent        = p,
	})
end
local function MakeList(p, pad, dir, ha, va)
	return New("UIListLayout", {
		Padding             = UDim.new(0, pad or 0),
		FillDirection       = dir or Enum.FillDirection.Vertical,
		SortOrder           = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = ha  or Enum.HorizontalAlignment.Left,
		VerticalAlignment   = va  or Enum.VerticalAlignment.Top,
		Parent              = p,
	})
end

local function Font(w)
	return Font.new and Font.new("rbxasset://fonts/families/GothamSSm.json", w)
		or Enum.Font.Gotham
end

local function MakeFont(weight)
	local ok, f = pcall(function()
		return Font_obj ~= nil and Font_obj
		or (function()
			local fn = (getfenv and getfenv(0) or _G).Font
			if fn and fn.new then return fn.new("rbxasset://fonts/families/GothamSSm.json", weight) end
		end)()
	end)
	if ok and f then return f end
	return Enum.Font.Gotham
end

local _FontNew = (typeof(Font) == "table" and Font.new) or nil
local function FF(weight)
	if _FontNew then
		return _FontNew("rbxasset://fonts/families/GothamSSm.json",
			weight or Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	end
	return Enum.Font.GothamMedium
end

local function GetGui()
	local gui        = Instance.new("ScreenGui")
	gui.ScreenInsets = Enum.ScreenInsets.None
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder     = 2147483647
	gui.IgnoreGuiInset   = true
	local parent
	if RunService:IsStudio() then
		parent = LocalPlayer:FindFirstChild("PlayerGui")
	else
		parent = (gethui and gethui())
			or (cloneref and cloneref(game:GetService("CoreGui")))
			or game:GetService("CoreGui")
	end
	gui.Parent = parent
	return gui
end

