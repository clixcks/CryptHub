									newSwatch.BackgroundTransparency=workAlpha
									inp.Changed:Connect(function()
										if inp.UserInputState==Enum.UserInputState.End then aDrag=false end
									end)
								end
							end)
							UserInputService.InputChanged:Connect(function(inp)
								if aDrag and inp.UserInputType==Enum.UserInputType.MouseMovement then
									workAlpha=1-math.clamp((inp.Position.X-alphaBar.AbsolutePosition.X)/alphaBar.AbsoluteSize.X,0,1)
									alphaThumb.Position=UDim2.new(1-workAlpha,0,0.5,0)
									newSwatch.BackgroundTransparency=workAlpha
								end
							end)
						end

						local function ParseRGB()
							local r=tonumber(rIn.Text) or 0
							local g=tonumber(gIn.Text) or 0
							local b=tonumber(bIn.Text) or 0
							workColor=Color3.fromRGB(
								math.clamp(r,0,255),
								math.clamp(g,0,255),
								math.clamp(b,0,255))
							hue,sat,val2=Color3.toHSV(workColor)
							UpdateSV()
						end
						local function ParseHex()
							local h=hexIn.Text:gsub("#","")
							if #h==6 then
								local r=tonumber(h:sub(1,2),16)
								local g=tonumber(h:sub(3,4),16)
								local b2=tonumber(h:sub(5,6),16)
								if r and g and b2 then
									workColor=Color3.fromRGB(r,g,b2)
									hue,sat,val2=Color3.toHSV(workColor)
									UpdateSV()
								end
							end
						end
						rIn.FocusLost:Connect(ParseRGB)
						gIn.FocusLost:Connect(ParseRGB)
						bIn.FocusLost:Connect(ParseRGB)
						hexIn.FocusLost:Connect(ParseHex)

						cancelBtn.MouseButton1Click:Connect(function() AnimOut() end)
						confirmBtn.MouseButton1Click:Connect(function()
							AnimOut(function()
								CPF.Color=workColor; CPF.Alpha=workAlpha
								hue,sat,val2=Color3.toHSV(workColor)
								RefreshDot(CPF.Color,CPF.Alpha)
								if Cfg.Callback then
									task.spawn(Cfg.Callback,CPF.Color,isAlpha and CPF.Alpha or nil)
								end
							end)
						end)
					end

					dotBtn.MouseButton1Click:Connect(OpenPicker)

					function CPF:SetColor(c)
						CPF.Color=c; hue,sat,val2=Color3.toHSV(c)
						RefreshDot(c,CPF.Alpha)
						if Cfg.Callback then task.spawn(Cfg.Callback,c,CPF.Alpha) end
					end
					function CPF:SetAlpha(a)
						CPF.Alpha=a; RefreshDot(CPF.Color,a)
					end
					function CPF:UpdateName(_)    end
					function CPF:SetVisibility(s) row.Visible=s end
					if Flag then UILib.Options[Flag]=CPF end
					return CPF
				end

